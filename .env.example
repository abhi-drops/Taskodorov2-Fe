# Base URL of the backend API. See Taskodoro-Frontend-Plan.md section 3 for
# local dev values (localhost vs 10.0.2.2 vs LAN IP vs adb reverse).
VITE_API_BASE_URL=http://localhost:8787

# Google OAuth Web Client ID (Google Cloud Console > Credentials > OAuth 2.0
# Client IDs > Web application). Leave empty to keep Google Sign-In visibly
# present but disabled on web.
VITE_GOOGLE_CLIENT_ID_WEB=

# Google OAuth Android Client ID (Google Cloud Console > Credentials > OAuth
# 2.0 Client IDs > Android, keyed to the appId + SHA-1). Leave empty to keep
# Google Sign-In visibly present but disabled on native Android.
VITE_GOOGLE_CLIENT_ID_ANDROID=
